# Google Gemini API Key for chemical safety / incompatibility analysis
# Get your free API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# (선택) Gemini 모델 ID. 기본값 gemini-3.5-flash-lite — 스캔 폴백은 빠른 응답이 필요해 lite 를 쓴다 (services/*.py).
# 3.1-flash-lite 는 2026-11 부터 "high demand" 503 이 잦아 기본값에서 뺐다.
# GEMINI_MODEL=gemini-3.5-flash-lite
