<?xml version="1.0" encoding="utf-8"?>
<!-- 스캔 정확도 측정 화면 (ScanBenchActivity) — 반입/반출 절차 없이 병 하나씩 스캔해 결정만 기록 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="스캔 정확도 측정"
            android:textColor="@color/text_strong"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="라벨 번호"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnLabelPrev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="−" />

        <EditText
            android:id="@+id/labelInput"
            android:layout_width="96dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:hint="12"
            android:inputType="text"
            android:textColor="@color/text_strong"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLabelNext"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="+" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@drawable/shape_rounded_14"
        android:backgroundTint="@color/camera_bg">

        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/scanStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:background="@color/primary"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="대기"
            android:textColor="@color/white"
            android:textSize="13sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/resultText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/white"
        android:padding="12dp"
        android:text="'다음 병 스캔'을 누르고 라벨을 비추세요"
        android:textColor="@color/text_strong"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/summaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="세션 0 · 자동 0 · 확인 0 · LLM 0 · 직접 0 · 미결 0"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="다음 병 스캔" />

        <Button
            android:id="@+id/btnManual"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="직접 선택" />

        <Button
            android:id="@+id/btnSkip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="미결 처리" />
    </LinearLayout>
</LinearLayout>
