<?xml version="1.0" encoding="utf-8"?>
<!-- app-shelf-manage (design-spec §3.4). 선반 카드/그리드는 코드에서 동적 생성 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_page"
        android:paddingEnd="@dimen/space_page"
        android:paddingTop="@dimen/space_top">

        <!-- 헤더 Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="선반 관리"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_strong" />
            <LinearLayout
                android:id="@+id/btnAddShelf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_pill_primary"
                android:elevation="3dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_plus"
                    android:contentDescription="추가"
                    app:tint="@color/white" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="새 선반 추가"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/scrollArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:overScrollMode="never"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <!-- 미등록 기기 스트립 -->
                <LinearLayout
                    android:id="@+id/unregisteredStripCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_strip_unreg"
                    android:elevation="2dp"
                    android:padding="12dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/unregCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_strong" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="기기를 길게 눌러 드래그하여 아래 선반의 원하는 위치에 배치하세요"
                            android:textSize="9sp"
                            android:textColor="@color/text_muted" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:scrollbars="none">
                        <LinearLayout
                            android:id="@+id/unregisteredDevicesLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- 기기 등록 카드 (드롭 후 노출) -->
                <LinearLayout
                    android:id="@+id/registerCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:background="@drawable/shape_rounded_14"
                    android:elevation="3dp"
                    android:padding="16dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_hard_drive"
                            android:contentDescription="기기"
                            app:tint="@color/primary" />
                        <TextView
                            android:id="@+id/registerCardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_strong" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/InputLabel"
                                android:text="디바이스 ID" />
                            <TextView
                                android:id="@+id/regDeviceIdText"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/input_height"
                                android:layout_marginTop="4dp"
                                android:gravity="center_vertical"
                                android:background="@drawable/shape_rounded_10"
                                android:backgroundTint="@color/bg"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_muted" />
                        </LinearLayout>

                        <Space
                            android:layout_width="10dp"
                            android:layout_height="1dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/InputLabel"
                                android:text="배치 위치" />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/input_height"
                                android:layout_marginTop="4dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="@drawable/shape_rounded_10"
                                android:backgroundTint="@color/primary_soft"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp">
                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:src="@drawable/ic_map_pin"
                                    android:contentDescription="위치"
                                    app:tint="@color/primary" />
                                <TextView
                                    android:id="@+id/regPositionText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/primary" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:gravity="bottom">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/InputLabel"
                                android:text="기기 식별 이름" />
                            <EditText
                                android:id="@+id/regNameInput"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/input_height"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_input"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:hint="입력하세요"
                                android:textColorHint="@color/text_muted"
                                android:textColor="@color/text_strong"
                                android:textSize="11sp"
                                android:inputType="text"
                                android:maxLines="1"
                                android:importantForAutofill="no" />
                        </LinearLayout>

                        <Space
                            android:layout_width="10dp"
                            android:layout_height="1dp" />

                        <LinearLayout
                            android:id="@+id/btnRegisterDevice"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/input_height"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:background="@drawable/bg_pill_primary"
                            android:elevation="3dp"
                            android:paddingStart="22dp"
                            android:paddingEnd="22dp">
                            <ImageView
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:src="@drawable/ic_check"
                                android:contentDescription="등록"
                                app:tint="@color/white" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="등록"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/white" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 선반 카드 컨테이너 (동적 생성) -->
                <LinearLayout
                    android:id="@+id/shelvesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/component_bottom_nav" />
</LinearLayout>
