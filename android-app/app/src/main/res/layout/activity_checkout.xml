<?xml version="1.0" encoding="utf-8"?>
<!-- app-checkout / -search (design-spec §3.9, §3.10) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_page"
        android:paddingEnd="@dimen/space_page"
        android:paddingTop="@dimen/space_top">

        <include
            android:id="@+id/appHeader"
            layout="@layout/component_app_header" />

        <!-- 검색바 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pill_outline"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">
            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_search"
                android:contentDescription="검색"
                app:tint="@color/text_muted" />
            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="반출할 시약 검색 — 위치를 LED로 안내해드립니다"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_strong"
                android:textSize="11sp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:maxLines="1"
                android:importantForAutofill="no" />
        </LinearLayout>

        <!-- 검색 결과 드롭다운 -->
        <LinearLayout
            android:id="@+id/searchResultsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:background="@drawable/shape_rounded_14"
            android:elevation="4dp"
            android:padding="8dp"
            android:visibility="gone">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/searchResultsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:overScrollMode="never" />
        </LinearLayout>

        <!-- 카메라 뷰 -->
        <FrameLayout
            android:id="@+id/cameraCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:background="@drawable/shape_rounded_14"
            android:backgroundTint="@color/camera_bg">

            <androidx.camera.view.PreviewView
                android:id="@+id/cameraPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:implementationMode="compatible" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="18dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/shape_pill"
                android:backgroundTint="@color/scrim_40"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">
                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/shape_circle"
                    android:backgroundTint="@color/danger" />
                <TextView
                    android:id="@+id/scanStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="스캔 중"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btnFlash"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_margin="18dp"
                android:background="@drawable/shape_circle"
                android:backgroundTint="@color/scrim_40">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_zap"
                    android:contentDescription="플래시"
                    app:tint="@color/white" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/scanFrame"
                android:layout_width="300dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_scan_frame">
                <View
                    android:id="@+id/scanLine"
                    android:layout_width="256dp"
                    android:layout_height="2dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_scan_line"
                    android:elevation="2dp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="18dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/shape_pill"
                android:backgroundTint="@color/scrim_50"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_scan_line"
                    android:contentDescription="스캔"
                    app:tint="@color/white" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="시약통 라벨을 프레임 안에 맞춰주세요"
                    android:textSize="10sp"
                    android:textColor="@color/white" />
            </LinearLayout>
        </FrameLayout>

        <!-- 인식 결과 카드 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:orientation="vertical"
            android:background="@drawable/shape_rounded_14"
            android:elevation="3dp"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="인식 결과"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_strong" />
                <TextView
                    android:id="@+id/resultBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_pill"
                    android:backgroundTint="@color/success_soft"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="서버 기록 완료"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/success"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/scanResultEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:gravity="center"
                android:text="카메라로 시약통 라벨을 스캔해 주세요"
                android:textSize="11sp"
                android:textColor="@color/text_muted" />

            <!-- 인식 실패 시 노출되는 직접 선택 폴백 -->
            <TextView
                android:id="@+id/btnManualSelect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:padding="10dp"
                android:gravity="center"
                android:background="@drawable/bg_pill_outline"
                android:text="인식이 어려우면 목록에서 직접 선택"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/scanResultActive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/shape_rounded_12"
                    android:backgroundTint="@color/primary_soft">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_flask_conical"
                        android:contentDescription="시약"
                        app:tint="@color/primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/scannedChemicalName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_strong" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:src="@drawable/ic_user"
                            android:contentDescription="반출자"
                            app:tint="@color/text_muted" />
                        <TextView
                            android:id="@+id/scannedOperatorInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textSize="11sp"
                            android:textColor="@color/text_body" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:src="@drawable/ic_map_pin"
                            android:contentDescription="위치"
                            app:tint="@color/text_muted" />
                        <TextView
                            android:id="@+id/scannedCheckoutDetails"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textSize="11sp"
                            android:textColor="@color/text_body" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp">
                    <FrameLayout
                        android:id="@+id/statusCircle"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/shape_circle"
                        android:backgroundTint="@color/success_soft">
                        <ImageView
                            android:id="@+id/statusIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_check"
                            android:contentDescription="상태"
                            app:tint="@color/success" />
                    </FrameLayout>
                    <TextView
                        android:id="@+id/statusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="반출 기록 완료"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/success" />
                    <TextView
                        android:id="@+id/statusSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="서버 저장됨"
                        android:textSize="8sp"
                        android:textColor="@color/text_muted" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/component_bottom_nav" />
</LinearLayout>
