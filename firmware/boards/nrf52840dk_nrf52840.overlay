/*
 * Smart shelf node on an E73-2G4M08S1C (nRF52840) module.
 *
 * The build target is the nRF52840 DK board definition; this overlay replaces
 * every DK specific pin assignment that the module uses differently. Only the
 * SoC parts of the DK board files are actually relied on.
 *
 * Pin map, verified against the pcb-smart-shelf schematic
 * (docs/build-and-flash.md section 9):
 *   P0.06  LED                          (U1/14, Q1 gate, active high)
 *   P0.08  CS1237 DRDY/DOUT             (U1/16)
 *   P1.09  CS1237 SCLK                  (U1/17)
 *   P0.12  load cell rail power switch  (U1/20, Q2 gate, active low)
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/adc/nrf-adc.h>

/* Shared with MCUboot - both images must agree on the flash layout. */
#include "../partitions.dtsi"

/ {
	aliases {
		shelf-led = &shelf_led;
	};

	shelf_leds: shelf-leds {
		compatible = "gpio-leds";

		shelf_led: shelf-led {
			/* Change to GPIO_ACTIVE_LOW if the LED is wired to VCC. */
			gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
			label = "Shelf LED";
		};
	};

	zephyr,user {
		/*
		 * Load cell + CS1237 rail switch. Q2 (AO3401A) is a P-channel
		 * high side switch: source = E73_3V3, drain = +3V3_C on J3,
		 * gate pulled up to the source by R11 (100k) and driven from
		 * P0.12 through R10 (1k). Pulling the gate LOW turns it ON,
		 * hence GPIO_ACTIVE_LOW.
		 *
		 * With ACTIVE_HIGH the logic is exactly inverted: cs1237_init()
		 * leaves the rail permanently on and cs1237_power_up() switches
		 * it off, so reads either time out (-116) or return 0 from a
		 * browning-out chip living off the bulk capacitance.
		 */
		loadcell-power-gpios = <&gpio0 12 GPIO_ACTIVE_LOW>;

		cs1237-sck-gpios  = <&gpio1 9 GPIO_ACTIVE_HIGH>;
		cs1237-dout-gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;

		/* Battery voltage via the SAADC's internal VDDH/5 tap - no
		 * external divider. VDDH is +BAT_FIN: the battery when running
		 * from it, or VBUS minus the D1 drop (~4.6 V) when USB is
		 * plugged in and Q5 has the battery disconnected. */
		io-channels = <&adc 0>;
	};

	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
	};
};

/*
 * The DK routes UART0 to P0.05..P0.08, which collides with the LED (P0.06) and
 * with CS1237 DOUT (P0.08). Console and shell go over USB CDC ACM instead.
 */
&uart0 {
	status = "disabled";
};

&uart1 {
	status = "disabled";
};

/*
 * REG0 is the high voltage regulator (VDDH -> VDD). The DK enables its DC/DC
 * converter because the DK carries an inductor on DCCH; this board does not
 * (the module's DCH pin is unconnected).
 *
 * zephyr/soc/nordic/nrf52/soc.c:39 turns the DC/DC on whenever this node is
 * "okay", and without the inductor REG0 cannot regulate: VDD collapses to the
 * 1.8 V default and UICR.REGOUT0 appears to have no effect. Leaving it in LDO
 * mode is what makes REGOUT0 work.
 *
 * Symptom when this is missing: a blank chip shows the configured 3.0 V, but as
 * soon as any firmware boots VDD drops to 1.8 V - on USB and on battery alike -
 * and USB never enumerates.
 */
&reg0 {
	status = "disabled";
};

/* Not used on this module, and the DK pins are free for other purposes. */
&i2c0 {
	status = "disabled";
};

&spi1 {
	status = "disabled";
};

/*
 * The DK carries an MX25R64 QSPI flash; this board does not. Left enabled the
 * driver probes it on every boot and logs
 *
 *     <err> qspi_nor: JEDEC id [ff ff ff] expect [c2 28 17]
 */
&mx25r64 {
	status = "disabled";
};

&qspi {
	status = "disabled";
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/* VDDH/5 with gain 1/2 against the 0.6 V internal reference gives a
	 * 0..12 V theoretical span - a 4.2 V Li-ion sits comfortably inside. */
	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_2";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_VDDHDIV5>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <4>;
	};
};
